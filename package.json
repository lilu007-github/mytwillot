    "format": "prettier --write 'packages/utils/**/*.{ts,tsx}' 'x-bookmarks/src/**/*.{ts,tsx,css}' 'x-bookmarks/public/*.js' 'x-bookmarks/__mocks__/*.ts' 'exporter/src/**/*.{ts,tsx,css}' 'x-bookmarks-automation/src/**/*.{ts,tsx,css}'",
